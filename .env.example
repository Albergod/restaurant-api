# Copia este archivo como .env y ajusta los valores.
# Los valores de abajo coinciden con el docker-compose.yml incluido,
# así que si usas Docker para PostgreSQL, funcionan tal cual.

DATABASE_URL=postgresql+asyncpg://restaurant:restaurant@localhost:5432/restaurant_db
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
